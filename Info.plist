<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleName</key>
	<string>@APP_NAME@</string>
	<key>CFBundleIdentifier</key>
	<string>@APP_IDENTIFIER@</string>
	<key>CFBundleExecutable</key>
	<string>@APP_NAME@</string>

	<key>CFBundleVersion</key>
	<string>@APP_VERSION@</string>
	<key>CFBundleShortVersionString</key>
	<string>@APP_SHORT_VERSION@</string>

	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>

	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2024-2025 Jack. All Rights Reserved.</string>

	<key>CFBundleIconFile</key>
	<string>logo.icns</string>

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>

	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	
	<key>NSHighResolutionCapable</key>
    <string>True</string>

	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>

	<key>LSUIElement</key>
    <true/>
		
	<key>NSDesktopFolderUsageDescription</key>
    <string>ScreenCapturer needs your permission to access the Desktop folder in order to save the image file.</string>
	
    <key>NSDocumentsFolderUsageDescription</key>
    <string>ScreenCapturer needs your permission to access the Documents folder in order to save the image file.</string>
	
    <key>NSDownloadsFolderUsageDescription</key>
    <string>ScreenCapturer needs your permission to access the Downloads folder in order to save the image file.</string>
	
    <key>NSRemoveableVolumesUsageDescription</key>
    <string>ScreenCapturer needs your permission to access removable volumes in order to save the image file.</string>
	
	<key>NSScreenCaptureUsageDescription</key>
	<string>Screen access is required for display handling</string>
</dict>
</plist>
